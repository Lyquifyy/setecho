{
  "name": "setecho-demo-motion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "studio": "npm run sync-assets && remotion studio src/index.ts",
    "check": "npm run sync-assets && tsc --noEmit",
    "render": "npm run check && node scripts/render.mjs",
    "stills": "npm run check && node scripts/render.mjs --stills"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "remotion": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
