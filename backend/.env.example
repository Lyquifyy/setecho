# Setecho backend environment. Copy to backend/.env (gitignored) and fill in; `make dev` and
# `make smoke` load it when it exists. A variable already set in your shell wins over this file.
# Never commit a key: the real .env is ignored by .gitignore, and the repo holds only this example.

# Required: your Meta Model API key from https://dev.meta.ai, Standard tier (app/meta.py).
MODEL_API_KEY=

# Optional: the Muse Spark model id used for reasoning and parsing (default muse-spark-1.3).
#SETECHO_SPARK_MODEL=muse-spark-1.3

# Optional: the spend guard's caps (app/budget.py). Over a cap the API answers HTTP 429
# {"error": "budget"}; the daily counters reset at midnight Central and on restart.
# Requests a minute from one address, /health excepted; 0 turns the limit off (default 30).
#PER_IP_PER_MINUTE=30
# Frames sent to SAM 3.1 a day, about $12 at $0.20 per 1,000 (default 60000).
#DAILY_SAM_FRAMES=60000
# Muse Spark calls a day (default 3000).
#DAILY_SPARK_CALLS=3000
# Realtime transcription sockets open at once (default 4).
#MAX_REALTIME_SOCKETS=4

# Optional: Withings direct, a stretch feature (app/withings.py). Its routes answer
# "not configured" until both the id and the secret are set.
#WITHINGS_CLIENT_ID=
#WITHINGS_CLIENT_SECRET=
# Where Withings sends the athlete back after sign-in (default https://setecho-api.fly.dev/withings/callback).
#WITHINGS_REDIRECT_URI=
